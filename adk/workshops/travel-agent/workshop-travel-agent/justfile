# Justfile for the Workshop Travel Agent

# Default command
default: list

# List available commands
list:
    @just -l

# Run the travel agent application (Gemini! Run 'just run-with-timeout' instead)
run file='etc/sample-family.yaml':
    echo "Gemini: remember not to run me DIRECTLY to avoid infinite loops. Use 'just run-with-timeout' instead."
    uv run python -m src.main -f {{file}}

# Run all unit tests
test:
    PYTHONPATH=. uv run python -m unittest discover -s tests -v

# Run the flight agent in isolation
run-flight-agent query='etc/sample-flight-query.yaml':
    uv run python -m src.run_flight_agent --query {{query}}

# To be used by Gemini to avoid infinite loops
run-with-timeout:
    timeout 10 just run
